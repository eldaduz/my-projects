# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (or local MongoDB) connection string
MONGODB_URI=mongodb://localhost:27017/ai-trip-planner

# Must match the client dev origin (Vite default) so cookies/CORS work locally
CORS_ORIGIN=http://localhost:5173

# Used starting in F02 — Authentication & Session Management (ATP-7)
JWT_SECRET=

# Used starting in F11 — PlanningContext & Gemini Integration Boundary (ATP-16)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# E2E test harness only — never set this in a real deployment. See
# server/scripts/e2eServer.js. Hard-disabled when NODE_ENV=production.
AI_ADAPTER_MODE=real

# Used starting in F03 — Authorization & Backend Security Baseline (ATP-8)
JSON_BODY_LIMIT=100kb
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Used starting in F14 — AI Reliability, Recovery & Abuse Protection (ATP-19)
AI_RATE_LIMIT_MAX=5
AI_RATE_LIMIT_WINDOW_MS=300000
AI_RATE_LIMIT_IP_MAX=20
AI_STALE_OPERATION_MS=120000

# Required only when NODE_ENV=production (F18.5 — ATP-85). Shared secret that
# Vercel Edge Middleware attaches to requests it proxies through the /api
# rewrite; this server rejects any /api/auth, /api/traveler-profiles or
# /api/trips request that doesn't carry it, so a caller hitting Render's own
# public URL directly can't forge X-Forwarded-For to evade per-IP rate
# limiting. Leave unset in development/test — the check is skipped outside
# production.
INTERNAL_PROXY_SECRET=
